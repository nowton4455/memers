# Private server RPC endpoint (recommended; never exposed to browser)
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
# Use devnet for wallet-based acceptance testing; mainnet-beta for production
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
PINATA_JWT=YOUR_PINATA_JWT_HERE
PINATA_GATEWAY=gateway.pinata.cloud

# Connect a public Vercel Blob store to this project (OIDC; no long-lived key needed).
# BLOB_STORE_ID is injected by Vercel. PINATA_JWT is an optional alternative.
